NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Correos que son admin de la plataforma (no de una Organization/pyme), separados por
# coma si son varios. Debe coincidir con el correo primario de la cuenta de Clerk.
ADMIN_EMAILS=

# Misma Postgres local que usa el resto del proyecto (ver ../.env)
DATABASE_URL=postgresql://aidmin:aidmin_dev_password@localhost:5432/aidmin

# El panel web NO reimplementa la logica de los gates: llama a los mismos servidores
# HTTP que ya usa n8n (npm run dev:approval-gate / dev:content-gate desde la raiz del
# repo tienen que estar corriendo).
APPROVAL_GATE_URL=http://localhost:4000
CONTENT_GATE_URL=http://localhost:4001

# --- SEO / analytics ---
# URL publica real del sitio (sin barra final) - usada en metadata, sitemap.xml y
# robots.txt. En dev local puede quedar vacia (cae a http://localhost:3000).
NEXT_PUBLIC_SITE_URL=https://aidmin.cl
# Google Analytics 4 - Measurement ID (formato G-XXXXXXXXXX). Vacio = GA4 no se
# carga. Sacalo de https://analytics.google.com (Admin > Flujos de datos).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console - codigo de verificacion por meta tag (Configuracion de la
# propiedad > Verificacion de la propiedad > etiqueta HTML, solo el valor del
# atributo content). Vacio = no se emite el meta tag de verificacion.
GOOGLE_SITE_VERIFICATION=

# Redes sociales reales de AIdmin (la empresa, no las de cada pyme cliente) - vacio
# = el icono no se muestra en el footer. Pegar la URL completa del perfil.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
