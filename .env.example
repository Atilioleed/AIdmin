# --- Tenant por defecto (uso CLI/n8n de un solo tenant; el panel web pasa tenantId
# explicito por request y no depende de esto). Obtenlo con:
#   SELECT id FROM tenants WHERE name = 'FIRMA IA SpA';
DEFAULT_TENANT_ID=

# --- Anthropic (default oficial) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo default, configurable sin tocar codigo
ANTHROPIC_MODEL=claude-sonnet-5

# --- Proveedor LLM opcional (ver agents/_shared/llm-client-factory.ts) ---
# Por defecto Agent usa el SDK oficial de Anthropic (arriba). Para probar sin una
# ANTHROPIC_API_KEY real contra un endpoint compatible con OpenAI (Groq, OpenRouter,
# Gemini), descomenta y completa:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=openrouter/free

# --- URL publica del panel web (agents/_shared/uploads-tool.ts arma URLs de fotos
# subidas por el cliente contra esto - Next.js sirve public/uploads/ desde aca).
# En dev local esto NO es alcanzable por los servidores de Anthropic (localhost),
# solo funciona una vez que web/ tenga un dominio publico real.
WEB_PUBLIC_BASE_URL=http://localhost:3000

# --- PostgreSQL (Docker local en este sprint; Supabase en produccion) ---
DATABASE_URL=postgresql://aidmin:aidmin_dev_password@localhost:5432/aidmin
POSTGRES_USER=aidmin
POSTGRES_PASSWORD=aidmin_dev_password
POSTGRES_DB=aidmin

# --- Canal humano (approval-gate HTTP) ---
APPROVAL_GATE_PORT=4000
# --- Canal humano para contenido (content-gate HTTP) ---
CONTENT_GATE_PORT=4001

# --- n8n (orquestador, self-hosted via Docker) ---
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_dev_only
N8N_ENCRYPTION_KEY=change_me_dev_only

# --- Agente de Desarrollo (piloto) ---
# Sitio de prueba (mock/sandbox) que el agente monitorea, NO produccion real
DEV_MONITOR_TARGET_URL=https://example.com
# Puerto del puente HTTP que n8n usa para disparar al agente (ver orchestrator/n8n)
DESARROLLO_TRIGGER_PORT=4100

# --- Agente de Finanzas ---
# Puerto del puente HTTP que n8n usa para disparar al agente (ver orchestrator/n8n)
FINANZAS_TRIGGER_PORT=4101

# --- Agente Legal ---
LEGAL_TRIGGER_PORT=4102

# --- Agente de Producto (unico con acceso web real, via Tavily) ---
PRODUCTO_TRIGGER_PORT=4103
TAVILY_API_KEY=

# --- CEO / chair del Comite (lee los reportes de los demas y arma la pauta) ---
CEO_TRIGGER_PORT=4104

# --- Agente de Marketing ---
MARKETING_TRIGGER_PORT=4105
# Con METRICOOL_API_KEY vacio, Marketing usa datos mock (agents/marketing/sample-data/).
# Cuando tengas una API key real de Metricool (https://app.metricool.com/settings/api),
# completala aqui - agents/marketing/tools.ts queda listo para leerla, pero falta el
# cliente real (mismo patron que agents/producto/tavily-client.ts) hasta que se conecte.
METRICOOL_API_KEY=
# Generador de contenido creativo (imagenes/video para ads) - aun no conectado. Cuando
# se elija un proveedor (ver opciones evaluadas en docs/architecture.md), su key va aqui.
CREATIVE_GENERATION_API_KEY=
