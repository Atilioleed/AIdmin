{
  "name": "aidmin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de agentes de IA autonomos que administran una pyme, con approval-gate y auditoria completa.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:desarrollo": "tsx agents/desarrollo/index.ts",
    "dev:desarrollo:server": "tsx agents/desarrollo/trigger-server.ts",
    "dev:approval-gate": "tsx approval-gate/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "dotenv": "^17.4.2",
    "openai": "^7.13.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
